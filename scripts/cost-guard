#!/usr/bin/env bash
# Emergency / routine cost control. --status (default) | --suspend-all. Usage: scripts/cost-guard [--dry-run] [--connection NAME] [--status|--suspend-all]
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/common.sh
. "$here/lib/common.sh"
parse_common_flags "$@"
conn="handson_admin"; mode="status"
set -- "${REST_ARGS[@]+"${REST_ARGS[@]}"}"
while [ $# -gt 0 ]; do
  case "$1" in --connection) conn="$2"; shift 2 ;; --status) mode=status; shift ;; --suspend-all) mode=suspend; shift ;; *) log_err "unknown arg $1"; exit 64 ;; esac
done
# Run a SHOW statement and print only the named columns as JSON (the default table output wraps unreadably).
show_json() {
  local q="$1"; shift
  if [ "$DRY_RUN" = "1" ]; then run snow sql -c "$conn" --format json -q "$q"; return 0; fi
  snow sql -c "$conn" --format json -q "$q" | python3 -c '
import sys, json
keys = sys.argv[1:]
print(json.dumps([{k: r.get(k) for k in keys} for r in json.load(sys.stdin)], indent=2))' "$@"
}
case "$mode" in
  status)
    echo "resource_monitors:"
    show_json "SHOW RESOURCE MONITORS" name level credit_quota used_credits remaining_credits frequency notify_at suspend_at suspend_immediately_at
    echo "warehouses:"
    show_json "SHOW WAREHOUSES" name state size auto_suspend auto_resume resource_monitor ;;
  suspend)
    if [ "$DRY_RUN" = "1" ]; then log_info "[dry-run] would suspend every started warehouse"; exit 0; fi
    names="$(snow sql -c "$conn" --format json -q "SHOW WAREHOUSES" | python3 -c "import sys,json; print(' '.join(w['name'] for w in json.load(sys.stdin) if w['state']!='SUSPENDED'))")"
    for w in $names; do snow sql -c "$conn" -q "ALTER WAREHOUSE \"$w\" SUSPEND" >/dev/null && log_info "suspended $w"; done
    [ -n "$names" ] || log_info "nothing running"
    # Dynamic Tables refresh on a schedule and wake their warehouse; suspend them too.
    dts="$(snow sql -c "$conn" --format json -q "SHOW DYNAMIC TABLES IN DATABASE HANBIT_CURATED" 2>/dev/null | python3 -c "import sys,json; print(' '.join(t['database_name']+'.'+t['schema_name']+'.'+t['name'] for t in json.load(sys.stdin) if t.get('scheduling_state')!='SUSPENDED'))" 2>/dev/null || true)"
    for t in $dts; do snow sql -c "$conn" -q "ALTER DYNAMIC TABLE $t SUSPEND" >/dev/null && log_info "suspended dynamic table $t"; done ;;
esac
