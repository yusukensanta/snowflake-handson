#!/usr/bin/env bash
# Scan a directory (default: repo root) for secrets that must never reach a public repo.
# Exit 0 = clean, 1 = finding. Pure grep so it works with no extra tools; also runs
# gitleaks when installed. Read-only: runs without --execute. Usage: scripts/check-secrets [--dry-run] [DIR]
set -u
here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/common.sh
. "$here/lib/common.sh"
parse_common_flags "$@"
mark_read_only
set -- "${REST_ARGS[@]+"${REST_ARGS[@]}"}"
# A mistyped flag or path must not end in "clean": grep errors are silenced below.
if [ $# -gt 1 ]; then log_err "usage: check-secrets [--dry-run] [DIR]"; exit 64; fi
root="${1:-$(cd "$here/.." && pwd)}"
case "$root" in -*) log_err "unknown arg $root"; exit 64 ;; esac
[ -e "$root" ] || { log_err "not found: $root"; exit 64; }
if [ "$PRINT_ONLY" = "1" ]; then log_info "[dry-run] would scan $root"; exit 0; fi
found=0
scan() { # label, regex
  local out
  out="$(grep -rEIn --exclude-dir=.git --exclude-dir=.terraform --exclude-dir=.venv \
        --exclude-dir=.superpowers --exclude-dir=node_modules --exclude-dir=__pycache__ \
        --exclude=check-secrets --exclude=test_check_secrets.sh --exclude=test_conn.py --exclude=.gitleaks.toml -e "$2" "$root" 2>/dev/null)"
  # shellcheck disable=SC2001
  if [ -n "$out" ]; then echo "[check-secrets] $1:"; echo "$out" | sed 's/^/  /'; found=1; fi
}
scan "private key material"        'BEGIN [A-Z ]*PRIVATE KEY'
scan "Snowflake account hostname"  '[A-Za-z0-9_-]+\.snowflakecomputing\.com'
scan "hard-coded credential"       '(password|passwd|secret|token|pat)[[:space:]]*[=:][[:space:]]*["'"'"'][^"'"'"'<$]{8,}["'"'"']'
scan "AWS access key id"           'AKIA[0-9A-Z]{16}'
scan "JWT-like token"              'eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}'
if command -v gitleaks >/dev/null 2>&1 && [ -d "$root/.git" ]; then
  gitleaks detect --no-banner --source "$root" --config "$root/.gitleaks.toml" >/dev/null 2>&1 || { echo "[check-secrets] gitleaks reported findings"; found=1; }
fi
[ "$found" -eq 0 ] && echo "[check-secrets] clean"
exit "$found"
