#!/usr/bin/env bash
# Destroy everything the lab created. DESTRUCTIVE: previews by default; acts only with --execute --yes.
# Order: suspend compute -> terraform destroy -> drop objects Terraform does not own.
# Usage: scripts/teardown [--execute --yes | --dry-run] [--connection NAME]
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/common.sh
. "$here/lib/common.sh"
parse_common_flags "$@"
PREVIEW_HINT="--execute --yes"
conn="handson_tf"; yes=0
set -- "${REST_ARGS[@]+"${REST_ARGS[@]}"}"
while [ $# -gt 0 ]; do
  case "$1" in --yes) yes=1; shift ;; --connection) conn="$2"; shift 2 ;; *) log_err "unknown arg $1"; exit 64 ;; esac
done
if [ "$DRY_RUN" = "0" ] && [ "$yes" != "1" ]; then
  log_err "teardown deletes data and roles. Re-run with --execute --yes (or without --execute to preview)."; exit 1
fi
run "$here/cost-guard" --execute --suspend-all --connection "$conn"
admin="handson_admin"   # owns the account monitor, user and role; TF_ADMIN cannot drop itself
run terraform -chdir="$here/../terraform/envs/handson" destroy -auto-approve
for stmt in "DROP DATABASE IF EXISTS HANBIT_OPS" "DROP RESOURCE MONITOR IF EXISTS HANDSON_ACCOUNT_MONITOR" \
            "DROP USER IF EXISTS TERRAFORM" "DROP ROLE IF EXISTS TF_ADMIN"; do
  run snow sql -c "$admin" -q "$stmt"
done
for wq in $WAREHOUSE_MONITORS; do
  run snow sql -c "$admin" -q "DROP RESOURCE MONITOR IF EXISTS ${wq%%:*}_MONITOR"
done
done_msg "done. Also delete ~/.snowflake/*.p8 keys you generated, and cancel the trial if finished."
