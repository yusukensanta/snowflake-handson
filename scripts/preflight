#!/usr/bin/env bash
# Day-0 checks. Exit 1 only when a BLOCKING item fails. --dry-run prints checks, runs nothing.
# Usage: scripts/preflight [--dry-run] [--connection NAME]   (default connection: handson_admin)
set -u
here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/common.sh
. "$here/lib/common.sh"
parse_common_flags "$@"
conn="handson_admin"
set -- "${REST_ARGS[@]+"${REST_ARGS[@]}"}"
while [ $# -gt 0 ]; do case "$1" in --connection) conn="$2"; shift 2 ;; *) shift ;; esac; done
blocked=0
row() { printf '%-28s %-6s %s\n' "$1" "$2" "$3"; [ "$2" = "block" ] && blocked=1; return 0; }
sql() { snow sql -c "$conn" --format json -q "$1" 2>/dev/null; }
py() { (cd "$here/.." && uv run python -m sfops.preflight "$1"); }

printf '%-28s %-6s %s\n' CHECK STATUS DETAIL
for t in terraform snow uv shellcheck gitleaks; do
  if command -v "$t" >/dev/null 2>&1; then row "tool:$t" ok "$(command -v "$t")"
  else row "tool:$t" block "missing; run scripts/install-tools"; fi
done
if [ "$DRY_RUN" = "1" ]; then
  for c in "snow connection test -c $conn" "SELECT CURRENT_REGION()" "SHOW ORGANIZATION ACCOUNTS (edition)" \
           "SHOW PARAMETERS LIKE 'CORTEX_ENABLED_CROSS_REGION' IN ACCOUNT" \
           "Iceberg probe: CREATE ICEBERG TABLE ... EXTERNAL_VOLUME='SNOWFLAKE_MANAGED' in PREFLIGHT_SCRATCH (dropped after)"; do
    printf '[dry-run] would run: %s\n' "$c"
  done
  [ "$blocked" -eq 0 ] || exit 1
  exit 0
fi
if snow connection test -c "$conn" >/dev/null 2>&1; then row connection ok "$conn"
else row connection block "cannot connect with '$conn'; see guide 01 (create connections.toml)"; fi
region="$(sql 'SELECT CURRENT_REGION()' | py region 2>/dev/null)"
case "$region" in
  aws:ap-northeast-2) row region ok "$region" ;;
  "") row region warn "could not read region; confirm AWS ap-northeast-2 in Snowsight" ;;
  *) row region warn "$region (guide assumes aws:ap-northeast-2; prices and AI availability differ)" ;;
esac
ed="$(sql 'SHOW ORGANIZATION ACCOUNTS' | py edition 2>/dev/null)"
case "$ed" in
  ENTERPRISE|BUSINESS_CRITICAL) row edition ok "$ed" ;;
  "") row edition warn "could not read edition (needs ORGADMIN); confirm Enterprise in Snowsight" ;;
  *) row edition block "$ed has no masking/row access policies; fallback: Enterprise trial required" ;;
esac
xr="$(sql "SHOW PARAMETERS LIKE 'CORTEX_ENABLED_CROSS_REGION' IN ACCOUNT" | grep -o '"value": *"[^"]*"' | head -1)"
row cortex-cross-region warn "${xr:-unknown}; fallback if CoCo unavailable: skip AI labs, stay in-region (spec 3). Never changed by this script."
probe="CREATE DATABASE IF NOT EXISTS PREFLIGHT_SCRATCH; CREATE SCHEMA IF NOT EXISTS PREFLIGHT_SCRATCH.T; CREATE OR REPLACE ICEBERG TABLE PREFLIGHT_SCRATCH.T.P (ID INT) CATALOG='SNOWFLAKE' EXTERNAL_VOLUME='SNOWFLAKE_MANAGED'; DROP DATABASE PREFLIGHT_SCRATCH"
if snow sql -c "$conn" -q "$probe" >/dev/null 2>&1; then row iceberg-snowflake-storage ok "created and dropped probe table"
else row iceberg-snowflake-storage warn "probe failed; fallback: Iceberg becomes conceptual + appendix (spec 3)"; fi
echo "Enter the credit rate shown on Snowsight Usage page, or press Enter to keep 4.50:" >&2
read -r rate_in; rate="$(printf '%s' "${rate_in:-4.50}" | py rate 2>/dev/null)"
if [ -n "$rate" ]; then row credit-rate ok "$rate USD/credit; budget = $(awk -v r="$rate" 'BEGIN{printf "%.0f", 400/r}') credits"
else row credit-rate warn "invalid input; using 4.50"; fi
[ "$blocked" -eq 0 ] || exit 1
