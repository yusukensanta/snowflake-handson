#!/usr/bin/env bash
# Emergency / routine cost control. --status (default, read-only) | --suspend-all (suspends only with --execute).
# --suspend-all stops started warehouses, Dynamic Tables and their data quality schedules. Alerts, tasks, pipes and
# other serverless features are not covered.
# Usage: scripts/cost-guard [--execute|--dry-run] [--connection NAME] [--dt-connection NAME] [--status|--suspend-all]
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/common.sh
. "$here/lib/common.sh"
parse_common_flags "$@"
conn="handson_admin"; dt_conn="handson_tf"; mode="status"
set -- "${REST_ARGS[@]+"${REST_ARGS[@]}"}"
while [ $# -gt 0 ]; do
  case "$1" in --connection) conn="$2"; shift 2 ;; --dt-connection) dt_conn="$2"; shift 2 ;; --status) mode=status; shift ;; --suspend-all) mode=suspend; shift ;; *) log_err "unknown arg $1"; exit 64 ;; esac
done
if [ "$mode" = status ]; then mark_read_only; fi
# Run a SHOW statement and print only the named columns as JSON (the default table output wraps unreadably).
show_json() {
  local q="$1"; shift
  if [ "$PRINT_ONLY" = "1" ]; then printf '[dry-run] snow sql -c %s --format json -q %s\n' "$conn" "$q"; return 0; fi
  snow sql -c "$conn" --format json -q "$q" | python3 -c '
import sys, json
keys = sys.argv[1:]
print(json.dumps([{k: r.get(k) for k in keys} for r in json.load(sys.stdin)], indent=2))' "$@"
}
case "$mode" in
  status)
    echo "resource_monitors:"
    show_json "SHOW RESOURCE MONITORS" name level credit_quota used_credits remaining_credits frequency notify_at suspend_at suspend_immediately_at
    echo "warehouses:"
    show_json "SHOW WAREHOUSES" name state size auto_suspend auto_resume resource_monitor ;;
  suspend)
    if [ "$DRY_RUN" = "1" ]; then log_info "[dry-run] would suspend every started warehouse, active Dynamic Table and data quality schedule; nothing is suspended"; exit 0; fi
    names="$(snow sql -c "$conn" --format json -q "SHOW WAREHOUSES" | python3 -c "import sys,json; print(' '.join(w['name'] for w in json.load(sys.stdin) if w['state']!='SUSPENDED'))")"
    failed=0
    for w in $names; do
      if snow sql -c "$conn" -q "ALTER WAREHOUSE \"$w\" SUSPEND" >/dev/null; then log_info "suspended $w"; else failed=1; fi
    done
    [ -n "$names" ] || log_info "nothing running"
    # Dynamic Tables refresh on a schedule and wake their warehouse; suspend them too. TF_ADMIN owns them and ACCOUNTADMIN
    # has no OPERATE on them (it fails with "Insufficient privileges"), so this part uses --dt-connection (default handson_tf).
    # Their data quality schedules (sql/dmf.sql) are serverless, so no resource monitor stops them. A suspended Dynamic
    # Table keeps its schedule, hence every table is listed. Set '' to suspend: UNSET restores the hourly default.
    # Check the database first so that a re-run after teardown is not an error, while a real listing failure is.
    if ! found="$(snow sql -c "$dt_conn" --format json -q "SHOW DATABASES LIKE 'HANBIT_CURATED'" \
        | python3 -c "import sys,json; print(len(json.load(sys.stdin)))" 2>/dev/null)"; then
      log_err "could not check for HANBIT_CURATED via $dt_conn"; failed=1
    elif [ "$found" = "0" ]; then
      log_info "HANBIT_CURATED is not visible to $dt_conn; nothing to suspend there"
    elif ! tables="$(snow sql -c "$dt_conn" --format json -q "SHOW DYNAMIC TABLES IN DATABASE HANBIT_CURATED" | python3 -c "
import sys, json
for t in json.load(sys.stdin):
    print(t['database_name'] + '.' + t['schema_name'] + '.' + t['name'], t.get('scheduling_state'))" 2>/dev/null)"; then
      log_err "could not list Dynamic Tables via $dt_conn"; failed=1
    else
      while read -r t state; do
        [ -n "$t" ] || continue
        if [ "$state" != "SUSPENDED" ]; then
          if snow sql -c "$dt_conn" -q "ALTER DYNAMIC TABLE $t SUSPEND" </dev/null >/dev/null; then log_info "suspended dynamic table $t"; else failed=1; fi
        fi
        if snow sql -c "$dt_conn" -q "ALTER TABLE $t SET DATA_METRIC_SCHEDULE = ''" </dev/null >/dev/null; then log_info "suspended data quality checks on $t"; else failed=1; fi
      done <<<"$tables"
    fi
    # An emergency stop that fails quietly is worse than one that fails loudly.
    [ "$failed" = "0" ] || { log_err "some suspends failed (see errors above); the stop is incomplete"; exit 1; } ;;
esac
