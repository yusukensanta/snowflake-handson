#!/usr/bin/env bash
# Attach each per-warehouse resource monitor (created by scripts/bootstrap) to its warehouse (created by Terraform).
# Only ACCOUNTADMIN can assign a warehouse to a resource monitor, so this runs on the admin connection, after
# `terraform apply`. Idempotent. Usage: scripts/attach-monitors [--dry-run] [--connection NAME]
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/common.sh
. "$here/lib/common.sh"
parse_common_flags "$@"
conn="handson_admin"
set -- "${REST_ARGS[@]+"${REST_ARGS[@]}"}"
while [ $# -gt 0 ]; do
  case "$1" in --connection) conn="$2"; shift 2 ;; *) log_err "unknown arg $1"; exit 64 ;; esac
done
for wq in $WAREHOUSE_MONITORS; do
  w="${wq%%:*}"
  run snow sql -c "$conn" -q "ALTER WAREHOUSE IF EXISTS $w SET RESOURCE_MONITOR = ${w}_MONITOR"
done
log_info "done. Check: scripts/cost-guard --status shows each warehouse's resource_monitor"
